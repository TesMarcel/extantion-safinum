{
  "manifest_version": 3,
  "name": "Safinum Lingua",
  "version": "0.2.0",
  "description": "Rend les services financiers numériques compréhensibles et audibles en langues camerounaises, sans modifier le site.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Safinum Lingua" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dictionary.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["audio/*"], "matches": ["<all_urls>"] }
  ]
}
